{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // sdk/core.ts predicts addresses through src/lib/vanity.ts – the same module
    // the openfair.app wizard mines with – and that file's own imports carry an
    // explicit .ts extension so `node --test` can load it directly. Legal here
    // because this project only emits declarations.
    "allowImportingTsExtensions": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types"
  },
  "include": ["sdk/npm.ts", "sdk/widget.ts", "sdk/core.ts", "sdk/element.ts", "src/lib/config.ts", "src/lib/abi.ts", "src/content/networks.d.mts"]
}
